# Copiez ce fichier en .env. Ne commitez jamais .env.
# Base de données externe (entre guillemets simples : le mot de passe peut contenir des caractères spéciaux)
DB_URL='jdbc:mysql://HOTE:3306/NOM_BASE?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true'
DB_USER=utilisateur
DB_PASSWORD='mot-de-passe'
# Uniquement pour la base locale de secours (docker compose --profile localdb up)
DB_ROOT_PASSWORD=
# 32 caractères minimum, aléatoires : openssl rand -base64 48
JWT_SECRET=
# Mot de passe initial du compte admin (changement obligatoire à la première connexion)
TAWASSOL_ADMIN_INITIAL_PASSWORD=
# Profil demo uniquement
TAWASSOL_DEMO_PASSWORD=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=prod
