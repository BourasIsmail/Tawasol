# Copiez ce fichier en .env. Ne commitez jamais .env.
# Base de données externe (entre guillemets simples : le mot de passe peut contenir des caractères spéciaux)
DB_URL='jdbc:mysql://HOTE:3306/NOM_BASE?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true'
DB_USER=utilisateur
DB_PASSWORD='mot-de-passe'
# Uniquement pour la base locale de secours (docker compose --profile localdb up)
DB_ROOT_PASSWORD=
# 32 caractères minimum, aléatoires : openssl rand -base64 48
JWT_SECRET=
# Mot de passe initial du compte admin (changement obligatoire à la première connexion)
TAWASSOL_ADMIN_INITIAL_PASSWORD=
# Profil demo uniquement
TAWASSOL_DEMO_PASSWORD=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=prod
# Port de l'application sur la VM (80 pour http://adresse-de-la-vm/)
WEB_PORT=3000

# --- Authentification par l'annuaire Active Directory (LDAPS, port 636) ---
LDAP_ENABLED=false
# Mot de passe du compte de service svc_tawassol_ldap : à saisir ICI uniquement (jamais dans git). Entre guillemets simples.
LDAP_BIND_PASSWORD=''
# Autorité de certification interne (PEM) si le certificat des contrôleurs n'est pas reconnu : placer le fichier dans ./certs puis LDAP_CA_FILE=/certs/ad-ca.pem
LDAP_CA_FILE=
# Attribut AD qui contient le matricule (« description » dans l'AD de l'Entraide Nationale, ex. P4071) ; à confirmer avec GET /api/v1/admin/ldap/recherche?identifiant=...
LDAP_MATRICULE_ATTRIBUTE=description

# --- Publication derrière un nom de domaine HTTPS (relais inverse) ---
# Adresse publique du site (sans / final) : liens des e-mails et QR de vérification
WEB_URL=https://tawassol2.entraide.ma
# Origines autorisées pour l'API, séparées par des virgules
CORS_ORIGINS=https://tawassol2.entraide.ma
# true quand le site n'est servi qu'en HTTPS ; false si l'accès par http://IP est aussi utilisé
COOKIE_SECURE=true
